# Test Environment Configuration
# Copy this file to .env.test.local and fill in real values for local testing

# ============================================
# TEST ACCOUNT CREDENTIALS (Required for real auth tests)
# ============================================
# Set these to use real Azure AD authentication in E2E tests.
# Without these, tests will run in bypass/development mode.

# Test user email (Azure AD B2C account)
E2E_TEST_USER_EMAIL=test-user@yourtenant.onmicrosoft.com

# Test user password
E2E_TEST_USER_PASSWORD=your-secure-password

# ============================================
# AZURE AD CONFIGURATION (Same as app config)
# ============================================
# These should match your Azure AD B2C app registration

# Application (client) ID from Azure AD
NEXT_PUBLIC_AZURE_CLIENT_ID=your-client-id-guid

# Directory (tenant) ID from Azure AD
NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id-guid

# ============================================
# NOTES
# ============================================
# 1. NEVER commit real credentials to source control
# 2. Add .env.test.local to .gitignore
# 3. For ROPC flow to work, enable "Allow public client flows" in Azure AD app registration
# 4. Create a dedicated test account in Azure AD B2C for E2E testing
# 5. The test account should have appropriate roles assigned for testing all features
