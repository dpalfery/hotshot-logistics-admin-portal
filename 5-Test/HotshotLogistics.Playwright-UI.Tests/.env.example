# Playwright E2E Test Configuration
# Copy this file to .env and fill in your values

# Test User Credentials
# Use a dedicated test account with appropriate permissions
E2E_TEST_USER_EMAIL=your-test-user@yourdomain.com
E2E_TEST_USER_PASSWORD=your-secure-password

# Azure AD Configuration
# These should match your admin dashboard Azure AD app registration
NEXT_PUBLIC_AZURE_CLIENT_ID=your-azure-ad-client-id
NEXT_PUBLIC_AZURE_TENANT_ID=your-azure-ad-tenant-id

# Optional: API Base URL (defaults to mocked endpoints)
# NEXT_PUBLIC_API_URL=http://localhost:5001
