{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Mapping": {
    "Provider": "Mock",
    "AzureMaps": {
      "SubscriptionKey": "YOUR_AZURE_MAPS_KEY_HERE"
    },
    "GoogleMaps": {
      "ApiKey": "YOUR_GOOGLE_MAPS_KEY_HERE"
    }
  },

  "AzureAdB2C": {
    "Instance": "${AZURE_AD_B2C_INSTANCE}",
    "ClientId": "${AZURE_AD_B2C_CLIENT_ID}",
    "Domain": "${AZURE_AD_B2C_DOMAIN}",
    "SignUpSignInPolicyId": "B2C_1_signupsignin1",
    "TenantId": "${AZURE_AD_B2C_TENANT_ID}",
    "Audience": "${AZURE_AD_B2C_AUDIENCE}"
  },

  "MicrosoftGraph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": "user.read"
  },

  "Jwt": {
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "RequireExpirationTime": true,
    "ClockSkew": "00:05:00"
  },

  "AllowedHosts": "${ALLOWED_HOSTS}",

  "Cors": {
    // Supports both array format (["https://example.com", "https://example2.com"])
    // and string format ("https://example.com,https://example2.com") for environment variables
    "AllowedOrigins": ["https://your-production-domain.com"]
  }
}
