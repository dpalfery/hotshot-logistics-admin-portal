{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "HotshotLogistics": "Debug"
    }
  },
  
  "Mapping": {
    "Provider": "Mock"
  },
  
  "AzureAdB2C": {
    "Instance": "https://YOUR_TENANT_NAME.ciamlogin.com",
    "ClientId": "YOUR_APPLICATION_CLIENT_ID",
