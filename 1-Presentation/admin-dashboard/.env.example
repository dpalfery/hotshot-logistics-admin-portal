# API Configuration
# URL of the backend API (Container App or local development)
# Required for Content Security Policy (CSP) to allow API calls
#
# Development: http://localhost:5000 or https://localhost:5001
# Production: https://ca-hotshot-api-<env>.<region>.azurecontainerapps.io
#
# Note: This must be set at BUILD time for static export
NEXT_PUBLIC_API_URL=http://localhost:5000

# Debug Logging Configuration
# Enable detailed debug logging for API requests and authentication flows
# WARNING: Only enable in development - never in production
# When enabled, shows sanitized request/response information
# Default: false (disabled)
# NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=true

# Azure AD / Entra External ID Configuration (Required for Production)
# These values are obtained from your Azure AD App Registration
# See: 6-Docs/admin-dashboard/AZURE_AD_SETUP.md for setup instructions
#
# Application (client) ID from Azure AD App Registration
# NEXT_PUBLIC_AZURE_CLIENT_ID=your-client-id-guid
#
# Directory (tenant) ID from Azure AD
# NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id-guid
#
# In CI/CD pipelines, these are mapped from GitHub secrets:
#   AZURE_AD_B2C_CLIENT_ID → NEXT_PUBLIC_AZURE_CLIENT_ID
#   AZURE_AD_B2C_TENANT_ID → NEXT_PUBLIC_AZURE_TENANT_ID
